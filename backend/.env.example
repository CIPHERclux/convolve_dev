# ═══════════════════════════════════════════════════════════════════
# Convolve MAS — Backend Environment Configuration
# Fill in your API key below, then save this file.
# ═══════════════════════════════════════════════════════════════════

# ── LLM Provider (pick ONE of the following) ─────────────────────

# Option 1: OpenAI (recommended — supports GPT-4o-mini tool calling)
OPENAI_API_KEY=

# Option 2: Groq (free tier — auto-selects llama-3.3-70b-versatile)
GROQ_API_KEY=

# ── LLM Settings (optional — auto-detected from provider) ───────
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=
# LLM_MAX_TOKENS=1024
# LLM_TEMPERATURE=0.7

# ── Qdrant Vector Database ───────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── App Settings ─────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
