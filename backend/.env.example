# Convolve MAS — Environment Configuration
# Copy to .env and fill in your values

# ── LLM ──────────────────────────────────────────────────────────────
LLM_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.groq.com/openai/v1  # Uncomment for Groq

# ── Qdrant ───────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── App ──────────────────────────────────────────────────────────────
DEBUG=true
HOST=0.0.0.0
PORT=8000
